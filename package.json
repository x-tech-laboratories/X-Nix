{
  "name": "x-nix",
  "private": true,
  "version": "0.3.0",
  "description": "A web portal for managing NixOS deployments",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "X_NIX_CONFIG=${X_NIX_CONFIG:-config.example.json} X_NIX_PASSWORD_HASH_FILE=${X_NIX_PASSWORD_HASH_FILE:-password.hash} node --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node src/server/main.ts",
    "test": "vitest run",
    "hash-password": "node src/server/hash_password.ts",
    "lint": "oxlint"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/session": "^11.1.6",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.5",
    "@x-tech-laboratories/halon": "^0.11.0",
    "@x-tech-laboratories/x-libs": "^0.33.0",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
