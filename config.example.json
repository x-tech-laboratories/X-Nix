{
  "hosts": [
    {
      "id": "workstation",
      "gc": {
        "max_generation_age": "30d",
        "warning": 90,
        "threshold": 96
      }
    },
    {
      "id": "server"
    },
    {
      "id": "pi",
      "keep_awake": true,
      "wake_on_lan": "aa:bb:cc:dd:ee:ff"
    }
  ],
  "flakes": [
    {
      "id": "workstation-config",
      "url": "/etc/nixos",
      "max_input_age": "14d"
    },
    {
      "id": "fleet",
      "name": "Fleet",
      "url": "github:example/nixos-config",
      "push_ssh_key": "/var/lib/x-nix/deploy_key",
      "update_at": "02:00",
      "watch_inputs": ["home-manager", "x-nix"],
      "access_tokens_file": "/run/secrets/rendered/nix-access-tokens"
    }
  ],
  "deployments": [
    {
      "id": "workstation",
      "name": "Workstation",
      "flake": "workstation-config",
      "configuration": "workstation",
      "build_at": "03:00",
      "tags": [
        "desktop"
      ]
    },
    {
      "id": "server",
      "host": "server",
      "flake": "fleet",
      "auto_switch": true,
      "auto_switch_after": "30m",
      "tags": [
        "canary",
        "servers"
      ],
      "pin": "v2026.10",
      "pre_switch_checks": [
        "test \"$(df --output=pcent /boot | tail -1 | tr -dc 0-9)\" -lt 90"
      ],
      "magic_rollback": true,
      "confirm_timeout": "30s",
      "health_commands": [
        "systemctl is-active --quiet nginx.service"
      ],
      "health_urls": [
        "https://server.example/health"
      ]
    },
    {
      "id": "pi",
      "host": "pi",
      "flake": "fleet",
      "configuration": "pi",
      "eval_agent": "server",
      "auto_switch": true,
      "magic_rollback": true,
      "post_switch": "systemctl restart display-manager.service",
      "cache": "fleet-cache"
    }
  ],
  "fleet": {
    "parallel": 2,
    "stages": [
      "@canary",
      "@servers"
    ],
    "sync_timeout": "30m"
  },
  "caches": [
    {
      "id": "fleet-cache",
      "name": "Fleet cache",
      "flake": "fleet",
      "configurations": [
        "workstation",
        "server",
        "pi"
      ],
      "cache_url": "https://attic.example/fleet",
      "build_root_dir": "/var/lib/x-nix/build-roots",
      "drop_pushed": [
        "server"
      ],
      "push_command": "attic push fleet",
      "eval_workers": 2,
      "health_url": "https://attic.example/health",
      "metrics_url": "https://attic.example/metrics",
      "build_at": "04:00"
    }
  ],
  "provisioning": {
    "ssh_key": "/var/lib/x-nix/install_key",
    "agent_url": "wss://nix.example.org/api/agent"
  }
}
