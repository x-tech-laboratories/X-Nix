{
  "deployments": [
    {
      "id": "workstation",
      "name": "Workstation",
      "flake": "/etc/nixos",
      "configuration": "workstation",
      "max_input_age": "14d",
      "build_at": "03:00",
      "gc": { "max_generation_age": "30d", "warning": 90, "threshold": 96 },
      "tags": ["desktop"]
    },
    {
      "id": "server",
      "host": "server",
      "flake": "github:example/nixos-config",
      "push_ssh_key": "/var/lib/x-nix/deploy_key",
      "update_at": "02:00",
      "auto_switch": true,
      "auto_switch_after": "30m",
      "tags": ["canary", "servers"],
      "pin": "v2026.10",
      "pre_switch_checks": ["test \"$(df --output=pcent /boot | tail -1 | tr -dc 0-9)\" -lt 90"],
      "magic_rollback": true,
      "confirm_timeout": "30s",
      "health_commands": ["systemctl is-active --quiet nginx.service"],
      "health_urls": ["https://server.example/health"],
      "secrets": [
        { "name": "database", "source": "/var/lib/x-nix/secrets/database", "owner": "postgres", "group": "postgres", "mode": "0400" }
      ]
    },
    {
      "id": "pi",
      "host": "pi",
      "flake": "github:example/nixos-config",
      "configuration": "pi",
      "eval_agent": "server",
      "cache_url": "https://attic.example/fleet",
      "switch_from_cache": true
    }
  ],
  "fleet": {
    "parallel": 2,
    "stages": ["@canary", "@servers"],
    "sync_timeout": "30m"
  },
  "caches": [
    {
      "id": "fleet-cache",
      "name": "Fleet cache",
      "flake": "github:example/nixos-config",
      "configurations": ["workstation", "server"],
      "cache_url": "https://attic.example/fleet",
      "build_root_dir": "/var/lib/x-nix/build-roots",
      "drop_pushed": ["server"],
      "push_command": "attic push fleet",
      "eval_workers": 2,
      "health_url": "https://attic.example/health",
      "metrics_url": "https://attic.example/metrics"
    }
  ],
  "provisioning": {
    "ssh_key": "/var/lib/x-nix/install_key",
    "agent_url": "wss://nix.example.org/api/agent"
  }
}
